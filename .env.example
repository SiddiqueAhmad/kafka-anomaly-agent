# Copy to .env and fill in real values. .env is gitignored.

# --- LLM / embeddings ---
GOOGLE_API_KEY=your-google-api-key

# --- Postgres ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=orders_db

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

